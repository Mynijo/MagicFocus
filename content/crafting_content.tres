[sub_resource type="Resource" id="Resource_4q6eo"]
script = ExtResource("88_bi3pr")
id = &"fire"
title = "Feuer"
words = PackedStringArray("Feuer", "Feuer-Essenz")
icon = ExtResource("89_rnyfn")
icon_color = Color(0.95, 0.35, 0.15, 1)
text = "Element. 1 Feuer-Essenz = 5 Punkte, nur für Gravuren mit Feuer.
Erzeugt: Burn, Perma-Burn, Accelerated Burn, Critical Chance, Crit.
Gravuren: [nolink]Feuerball, Meteor, Fire Rain, Permanent Burn, Accelerated Burn, Critical Chance, Crit, Burn[/nolink]."

[sub_resource type="Resource" id="Resource_yyblq"]
script = ExtResource("88_bi3pr")
id = &"water"
title = "Wasser"
words = PackedStringArray("Wasser", "Wasser-Essenz")
icon = ExtResource("90_82c63")
icon_color = Color(0.2, 0.55, 1, 1)
text = "Element. 1 Wasser-Essenz = 5 Punkte, nur für Gravuren mit Wasser.
Erzeugt: Leben-Reg, Nass, Cleanse, Bless, Life Rewind, Armor, Mana Absorption, Blood Thinner, Max Health.
Gravuren: [nolink]Freeze, Heal, Leben-Reg, Wasser-Detonation, Water Rain, Cleanse, Bless, Life Rewind, Mana Absorption, Blood Thinner, Vampire, Max Health, Mana-Reduktion, Nass, Mana Efficiency, Quick Cast, Regeneration[/nolink]."

