[sub_resource type="Resource" id="Resource_lp6gv"]
script = ExtResource("83_ve5ej")
id = &"fire"
title = "Feuer"
words = PackedStringArray("Feuer", "Feuer-Essenz")
icon = ExtResource("84_knhwa")
icon_color = Color(0.95, 0.35, 0.15, 1)
text = "Ein Element. Eine Feuer-Essenz zählt 5 Punkte für Gravuren mit diesem Element, für andere Gravuren nichts (außer Magischer Bolzen). Erzeugt: Burn, Crit, Perma-Burn, Accelerated Burn, Critical Chance.
Gravuren: Feuerball, Meteor, Fire Rain, Permanent Burn, Accelerated Burn, Critical Chance, Crit, Burn."

[sub_resource type="Resource" id="Resource_2d31c"]
script = ExtResource("83_ve5ej")
id = &"water"
title = "Wasser"
words = PackedStringArray("Wasser", "Wasser-Essenz")
icon = ExtResource("85_2ftak")
icon_color = Color(0.2, 0.55, 1, 1)
text = "Ein Element. Eine Wasser-Essenz zählt 5 Punkte für Gravuren mit diesem Element, für andere Gravuren nichts (außer Magischer Bolzen). Erzeugt: Nass, Leben-Reg, Bless, Life Rewind, Max Health, Blood Thinner.
Gravuren: Freeze, Heal, Leben-Reg, Wasser-Detonation, Water Rain, Cleanse, Bless, Life Rewind, Mana Absorption, Blood Thinner, Vampire, Max Health, Mana-Reduktion, Nass, Mana Efficiency, Quick Cast, Regeneration."

[sub_resource type="Resource" id="Resource_1gw52"]
script = ExtResource("83_ve5ej")
id = &"earth"
title = "Erde"
words = PackedStringArray("Erde", "Erde-Essenz", "Erd-Essenz")
icon = ExtResource("86_ed2qg")
icon_color = Color(0.62, 0.45, 0.25, 1)
text = "Ein Element. Eine Erde-Essenz zählt 5 Punkte für Gravuren mit diesem Element, für andere Gravuren nichts (außer Magischer Bolzen). Erzeugt: Armor, Armor Break, Thorns, Damage Reduction, Mana Absorption, Rotten, Blood Thinner.
Gravuren: Schutz, Kanone, Bulwark, Damage Reduction, Mana Absorption, Blood Thinner, Rot, Armor, Armor Break, Radius Expansion, Thorns."

[sub_resource type="Resource" id="Resource_fired"]
script = ExtResource("83_ve5ej")
id = &"air"
title = "Luft"
words = PackedStringArray("Luft", "Luft-Essenz")
icon = ExtResource("87_hh12o")
icon_color = Color(0.7, 0.95, 0.9, 1)
text = "Ein Element. Eine Luft-Essenz zählt 5 Punkte für Gravuren mit diesem Element, für andere Gravuren nichts (außer Magischer Bolzen). Erzeugt: Bleed, Slowed, Hasted, Accelerated Burn.
Gravuren: Freeze, Slow, Hasted, Luftklinge, Accelerated Burn, Cast-Speed, Bleed, Mana Efficiency, Quick Cast."

[sub_resource type="Resource" id="Resource_e3hj6"]
script = ExtResource("83_ve5ej")
id = &"lightning"
title = "Blitz"
words = PackedStringArray("Blitz", "Blitz-Essenz")
icon = ExtResource("88_oq37p")
icon_color = Color(1, 0.88, 0.2, 1)
text = "Ein Element. Eine Blitz-Essenz zählt 5 Punkte für Gravuren mit diesem Element, für andere Gravuren nichts (außer Magischer Bolzen). Erzeugt: Schock, Mana Burn, Mana-Reg.
Gravuren: Mana-Reg, Blitzschlag, Dispel, Thunderstorm, Mana Burn, Schock, Critical Damage."

[sub_resource type="Resource" id="Resource_cf3ep"]
script = ExtResource("83_ve5ej")
id = &"bleed"
title = "Bleed"
words = PackedStringArray("Bleed")
icon = ExtResource("89_6u04t")
text = "Verursacht pro Stack X Schaden pro Sekunde. Verliert 1 Stack pro Sekunde. Entsteht aus Luft-Essenz.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_ykw7k"]
script = ExtResource("83_ve5ej")
id = &"slowed"
title = "Slowed"
words = PackedStringArray("Slowed", "Slow")
icon = ExtResource("90_sttmv")
text = "Verlängert die Cast-Zeit des Gegners um X Sekunden. Verliert 1 Stack pro Sekunde, höchstens 10 Stacks. Slowed und Hasted heben sich 1 : 1 auf.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_pos0j"]
script = ExtResource("83_ve5ej")
id = &"hasted"
title = "Hasted"
words = PackedStringArray("Hasted")
icon = ExtResource("91_w3040")
text = "Verkürzt die eigene Cast-Zeit um X Sekunden. Verliert 1 Stack pro Sekunde, höchstens 10 Stacks. Hasted und Slowed heben sich 1 : 1 auf.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_twvyk"]
script = ExtResource("83_ve5ej")
id = &"mana_burn"
title = "Mana Burn"
words = PackedStringArray("Mana Burn")
icon = ExtResource("92_g8bn4")
text = "Senkt die Mana-Reg des Gegners um X pro Sekunde. Verliert 1 Stack pro gesenkter Mana-Reg. Entsteht aus Blitz-Essenz.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_eef25"]
script = ExtResource("83_ve5ej")
id = &"armor"
title = "Armor"
words = PackedStringArray("Armor")
icon = ExtResource("93_bi3pr")
text = "Verhindert X Schaden. Verliert 1 Stack pro verhindertem Schaden. Armor Break hebt Armor im Verhältnis 1 : 5 auf.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_4q6eo"]
script = ExtResource("83_ve5ej")
id = &"schock"
title = "Schock"
words = PackedStringArray("Schock")
icon = ExtResource("94_rnyfn")
text = "Verursacht 1 Schaden pro Mana, das der Gegner verbraucht (höchstens so viel wie Stacks). Verliert 1 Stack pro verbrauchtem Mana. Nass verstärkt den Schaden. Entsteht aus Blitz-Essenz.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_yyblq"]
script = ExtResource("83_ve5ej")
id = &"nass"
title = "Nass"
words = PackedStringArray("Nass")
icon = ExtResource("95_82c63")
text = "Erhöht den Schaden von Schock um X. Nass und Burn heben sich 1 : 1 auf. Freeze wandelt 100 Nass in 1 Eis. Entsteht aus Wasser-Essenz.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_kywfh"]
script = ExtResource("83_ve5ej")
id = &"eis"
title = "Eis"
words = PackedStringArray("Eis")
icon = ExtResource("96_oiesj")
text = "Betäubt X Sekunden: Der Gegner kann nicht zaubern. Verliert 1 Stack pro Sekunde. Entsteht, wenn Freeze Nass umwandelt.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_6togp"]
script = ExtResource("83_ve5ej")
id = &"burn"
title = "Burn"
words = PackedStringArray("Burn")
icon = ExtResource("97_3k51r")
text = "Verursacht X Schaden pro Sekunde. Verliert 1 Stack pro Sekunde. Nass und Burn heben sich 1 : 1 auf. Entsteht aus Feuer-Essenz.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_60l5b"]
script = ExtResource("83_ve5ej")
id = &"leben_reg"
title = "Leben-Reg"
words = PackedStringArray("Leben-Reg")
icon = ExtResource("98_5bj24")
text = "Heilt 1 Leben pro Sekunde und Stack. Verliert 1 Stack pro Sekunde. Entsteht aus Wasser-Essenz.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_dsovf"]
script = ExtResource("83_ve5ej")
id = &"mana_reg"
title = "Mana-Reg"
words = PackedStringArray("Mana-Reg")
icon = ExtResource("99_buwc3")
text = "Gibt 1 Mana pro Sekunde und Stack. Verliert 1 Stack pro Sekunde. Mana Burn senkt sie. Entsteht aus Blitz-Essenz.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_hmfx2"]
script = ExtResource("83_ve5ej")
id = &"armor_break"
title = "Armor Break"
words = PackedStringArray("Armor Break")
icon = ExtResource("100_tedi0")
text = "Hebt Armor im Verhältnis 1 : 5 auf. Entsteht aus Erd-Essenz.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_vahik"]
script = ExtResource("83_ve5ej")
id = &"crit"
title = "Crit"
words = PackedStringArray("Crit")
icon = ExtResource("101_qf4i7")
text = "1 Crit = 1 % Chance auf einen kritischen Treffer. Ein kritischer Treffer macht 200 % Schaden. Entsteht aus Feuer-Essenz.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_101t7"]
script = ExtResource("83_ve5ej")
id = &"perma_burn"
title = "Perma-Burn"
words = PackedStringArray("Perma-Burn")
icon = ExtResource("102_1w0a0")
text = "Debuff. Erzeugt pro Stack jede Sekunde Burn. Baut sich nicht ab; nur Cleanse entfernt ihn.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_c5c5k"]
script = ExtResource("83_ve5ej")
id = &"accelerated_burn"
title = "Accelerated Burn"
words = PackedStringArray("Accelerated Burn")
icon = ExtResource("103_08kwt")
text = "Debuff. Solange er wirkt, tickt Burn zweimal pro Sekunde: gleicher Gesamtschaden in der halben Zeit. Verliert 1 Stack pro Sekunde.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_dhp4a"]
script = ExtResource("83_ve5ej")
id = &"bless"
title = "Bless"
words = PackedStringArray("Bless")
icon = ExtResource("104_wwwad")
text = "Buff. Jede erhaltene Heilung (auch Leben-Reg) heilt pro Stack X mehr und verbraucht 1 Stack.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_xjdh7"]
script = ExtResource("83_ve5ej")
id = &"thorns"
title = "Thorns"
words = PackedStringArray("Thorns")
icon = ExtResource("105_bjxqb")
text = "Buff. Wird der Träger von einem Spell getroffen, erhält der Angreifer pro Stack X Schaden; verbraucht 1 Stack pro Treffer.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_pcw08"]
script = ExtResource("83_ve5ej")
id = &"mana_absorption"
title = "Mana Absorption"
words = PackedStringArray("Mana Absorption")
icon = ExtResource("106_va580")
text = "Buff. Wird der Träger von einem Spell getroffen, erhält er pro Stack X Mana; verbraucht 1 Stack pro Treffer.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_rbbfg"]
script = ExtResource("83_ve5ej")
id = &"damage_reduction"
title = "Damage Reduction"
words = PackedStringArray("Damage Reduction")
icon = ExtResource("107_mwfnp")
text = "Buff. Halbiert den Schaden des nächsten gegnerischen Spells (alle Treffer); 1 Stack pro Spell.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_witpl"]
script = ExtResource("83_ve5ej")
id = &"life_rewind"
title = "Life Rewind"
words = PackedStringArray("Life Rewind")
icon = ExtResource("108_kf5hb")
text = "Buff. Speichert das aktuelle Leben; nach 10 Sekunden wird das Leben auf diesen Wert gesetzt, auch nach unten. Tödlicher Schaden tötet trotzdem.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_11ro5"]
script = ExtResource("83_ve5ej")
id = &"cleanse"
title = "Cleanse"
words = PackedStringArray("Cleanse")
icon = ExtResource("109_v8gim")
text = "Entfernt alle Debuffs vom Ziel: Burn, Bleed, Nass, Schock, Slowed, Mana Burn, Eis, Perma-Burn, Accelerated Burn, Blood Thinner, Cauterized, Rotten.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_14mf6"]
script = ExtResource("83_ve5ej")
id = &"dispel"
title = "Dispel"
words = PackedStringArray("Dispel")
icon = ExtResource("110_vdjcu")
text = "Pro Stack wird ein Buff des Ziels mit allen seinen Stacks entfernt, der mit den meisten Stacks zuerst. Buffs: Armor, Hasted, Leben-Reg, Mana-Reg, Bless, Thorns, Mana Absorption, Damage Reduction, Life Rewind, Critical Chance, Max Health.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_160co"]
script = ExtResource("83_ve5ej")
id = &"critical_chance"
title = "Critical Chance"
words = PackedStringArray("Critical Chance")
icon = ExtResource("111_6ecqk")
text = "Buff. +1 % Crit-Chance pro Stack auf die eigenen Spells. Bleibt bis zum nächsten Crit, dann werden alle Stacks verbraucht.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_18ksk"]
script = ExtResource("83_ve5ej")
id = &"blood_thinner"
title = "Blood Thinner"
words = PackedStringArray("Blood Thinner")
icon = ExtResource("112_e55j2")
text = "Debuff. Solange er wirkt, tickt Bleed zweimal pro Sekunde: gleicher Gesamtschaden in der halben Zeit. Verliert 1 Stack pro Sekunde.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_xunj5"]
script = ExtResource("83_ve5ej")
id = &"cauterized"
title = "Cauterized"
words = PackedStringArray("Cauterized")
icon = ExtResource("113_mkia2")
text = "Debuff. Entsteht, wenn jemand Bleed und Burn zugleich hat: je 1 Bleed und 1 Burn werden zu 1 Cauterized. Verhindert die nächste Heilung (auch Leben-Reg) und verliert dabei 1 Stack.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_282b6"]
script = ExtResource("83_ve5ej")
id = &"max_health"
title = "Max Health"
words = PackedStringArray("Max Health")
icon = ExtResource("114_ajftg")
text = "Buff. +X maximales Leben pro Stack. Hebt nur das Maximum, nicht das aktuelle Leben. Baut sich nicht ab.
(Kampfregel, wirkt ab dem Auto-Battler.)"

[sub_resource type="Resource" id="Resource_jpsvq"]
script = ExtResource("83_ve5ej")
id = &"rotten"
title = "Rotten"
words = PackedStringArray("Rotten")
icon = ExtResource("115_qfkba")
text = "Debuff. -X maximales Leben pro Stack; das Leben sinkt mit, wenn es darüber liegt. Baut sich nicht ab; nur Cleanse entfernt ihn.
(Kampfregel, wirkt ab dem Auto-Battler.)"

