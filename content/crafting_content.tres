id = &"damage_reduction"
title = "Damage Reduction"
words = PackedStringArray("Damage Reduction")
icon = ExtResource("113_2d31c")
text = "Buff. Der nächste gegnerische Spell macht nur 50 % Schaden (alle Treffer); verbraucht 1 Stack."

[sub_resource type="Resource" id="Resource_4ybdo"]
script = ExtResource("88_bi3pr")
id = &"life_rewind"
title = "Life Rewind"
words = PackedStringArray("Life Rewind")
icon = ExtResource("114_1gw52")
text = "Buff. Merkt sich das Leben; nach 10 s wird es darauf gesetzt, auch nach unten. Tod ist endgültig."

[sub_resource type="Resource" id="Resource_oulfi"]
script = ExtResource("88_bi3pr")
id = &"critical_chance"
title = "Critical Chance"
words = PackedStringArray("Critical Chance")
icon = ExtResource("115_fired")
text = "Buff. +1 % Crit-Chance pro Stack. Beim nächsten Crit werden alle Stacks verbraucht."

[sub_resource type="Resource" id="Resource_tp7uh"]
script = ExtResource("88_bi3pr")
id = &"max_health"
title = "Max Health"
words = PackedStringArray("Max Health")
icon = ExtResource("116_e3hj6")
text = "Buff. +2 maximales Leben pro Stack (nicht das aktuelle Leben). Baut sich nicht ab."

[sub_resource type="Resource" id="Resource_titby"]
script = ExtResource("88_bi3pr")
id = &"crit"
title = "Crit"
words = PackedStringArray("Crit")
icon = ExtResource("117_cf3ep")
text = "Spell-Wert. 1 Crit = 1 % Chance pro Treffer auf 200 % Schaden."

[sub_resource type="Resource" id="Resource_4jqiy"]
script = ExtResource("88_bi3pr")
id = &"armor_break"
title = "Armor Break"
words = PackedStringArray("Armor Break")
icon = ExtResource("118_ykw7k")
text = "Spell-Wert. Entfernt beim Treffer 5 Armor pro Stack."

[sub_resource type="Resource" id="Resource_w0f0e"]
script = ExtResource("88_bi3pr")
id = &"cleanse"
title = "Cleanse"
words = PackedStringArray("Cleanse")
icon = ExtResource("119_pos0j")
text = "Spell-Wert. Entfernt alle Debuffs des Ziels."

[sub_resource type="Resource" id="Resource_7xqc4"]
script = ExtResource("88_bi3pr")
id = &"dispel"
title = "Dispel"
words = PackedStringArray("Dispel")
icon = ExtResource("120_twvyk")
text = "Spell-Wert. Pro Stack wird ein Buff des Ziels ganz entfernt, der mit den meisten Stacks zuerst."

[sub_resource type="Resource" id="Resource_fvqee"]
script = ExtResource("88_bi3pr")
id = &"points"
title = "Punkte"
words = PackedStringArray("Punkte")
text = "Grundlage jeder Gravur: neutrale Essenz zählt 1, eine Essenz ihren Faktor, aber nur für Gravuren mit ihrem Element. Sonst zählt sie nichts."

[sub_resource type="Resource" id="Resource_s10sl"]
script = ExtResource("88_bi3pr")
id = &"spitz"
title = "Spitz"
words = PackedStringArray("Spitz")
text = "Gem-Form: sammelt im Innenwinkel, alles Eingesammelte zählt doppelt. Grob sammelt im Außenwinkel einfach."

