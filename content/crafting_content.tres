[sub_resource type="Resource" id="Resource_dsovf"]
script = ExtResource("88_bi3pr")
id = &"debuff"
title = "Debuff"
words = PackedStringArray("Debuff", "Debuffs")
text = "Schadet dem Träger; Cleanse entfernt alle: Burn, Bleed, Nass, Schock, Slowed, Mana Burn, Eis, Perma-Burn, Accelerated Burn, Blood Thinner, Cauterized, Rotten."

[sub_resource type="Resource" id="Resource_hmfx2"]
script = ExtResource("88_bi3pr")
id = &"buff"
title = "Buff"
words = PackedStringArray("Buff", "Buffs")
text = "Hilft dem Träger; Dispel entfernt sie: Armor, Hasted, Leben-Reg, Mana-Reg, Bless, Thorns, Mana Absorption, Damage Reduction, Life Rewind, Critical Chance, Max Health."

[sub_resource type="Resource" id="Resource_vahik"]
script = ExtResource("88_bi3pr")
id = &"burn"
title = "Burn"
words = PackedStringArray("Burn")
icon = ExtResource("94_buwc3")
text = "Debuff. 2 Schaden pro Stack und Sekunde, danach -1 Stack. Hebt sich 1 : 1 mit Nass auf; mit Bleed entsteht Cauterized."

[sub_resource type="Resource" id="Resource_101t7"]
script = ExtResource("88_bi3pr")
id = &"bleed"
title = "Bleed"
words = PackedStringArray("Bleed")
icon = ExtResource("95_tedi0")
text = "Debuff. 2 Schaden pro Stack und Sekunde, danach -1 Stack. Mit Burn entsteht Cauterized."

[sub_resource type="Resource" id="Resource_c5c5k"]
script = ExtResource("88_bi3pr")
id = &"wet"
title = "Nass"
words = PackedStringArray("Nass")
icon = ExtResource("96_qf4i7")
text = "Debuff. +1 Schock-Schaden pro Stack. Hebt sich 1 : 1 mit Burn auf. Freeze wandelt Nass in Eis."

[sub_resource type="Resource" id="Resource_dhp4a"]
script = ExtResource("88_bi3pr")
id = &"shock"
title = "Schock"
words = PackedStringArray("Schock")
icon = ExtResource("97_1w0a0")
text = "Debuff. Gibt der Träger Mana aus: 1 Schaden und -1 Stack pro Mana (höchstens alle Stacks). Nass verstärkt den Schaden."

[sub_resource type="Resource" id="Resource_xjdh7"]
script = ExtResource("88_bi3pr")
id = &"slow"
title = "Slowed"
words = PackedStringArray("Slowed", "Slow")
icon = ExtResource("98_08kwt")
text = "Debuff. Nächster Cast +0,1 s pro Stack; dabei werden alle Stacks verbraucht. Höchstens 10 Stacks, hebt sich 1 : 1 mit Hasted auf."

[sub_resource type="Resource" id="Resource_pcw08"]
script = ExtResource("88_bi3pr")
id = &"mana_burn"
title = "Mana Burn"
words = PackedStringArray("Mana Burn")
icon = ExtResource("99_wwwad")
text = "Debuff. Senkt die Mana-Reg um 1 pro Stack und Sekunde; die genutzten Stacks werden verbraucht."

[sub_resource type="Resource" id="Resource_rbbfg"]
script = ExtResource("88_bi3pr")
id = &"ice"
title = "Eis"
words = PackedStringArray("Eis")
icon = ExtResource("100_bjxqb")
text = "Debuff. Betäubt: kein neuer Cast, ein laufender pausiert. -1 Stack pro Sekunde."

[sub_resource type="Resource" id="Resource_witpl"]
script = ExtResource("88_bi3pr")
id = &"perma_burn"
title = "Perma-Burn"
words = PackedStringArray("Perma-Burn")
icon = ExtResource("101_va580")
text = "Debuff. Erzeugt pro Stack 1 Burn pro Sekunde. Baut sich nicht ab, nur Cleanse entfernt ihn."

[sub_resource type="Resource" id="Resource_11ro5"]
script = ExtResource("88_bi3pr")
id = &"accelerated_burn"
title = "Accelerated Burn"
words = PackedStringArray("Accelerated Burn")
icon = ExtResource("102_mwfnp")
text = "Debuff. Burn tickt zweimal pro Sekunde: gleicher Schaden in halber Zeit. -1 Stack pro Sekunde."

[sub_resource type="Resource" id="Resource_14mf6"]
script = ExtResource("88_bi3pr")
id = &"blood_thinner"
title = "Blood Thinner"
words = PackedStringArray("Blood Thinner")
icon = ExtResource("103_kf5hb")
text = "Debuff. Bleed tickt zweimal pro Sekunde: gleicher Schaden in halber Zeit. -1 Stack pro Sekunde."

[sub_resource type="Resource" id="Resource_160co"]
script = ExtResource("88_bi3pr")
id = &"cauterized"
title = "Cauterized"
words = PackedStringArray("Cauterized")
icon = ExtResource("104_v8gim")
text = "Debuff. Entsteht aus je 1 Bleed und 1 Burn. Verhindert die nächste Heilung und verliert dabei 1 Stack."

[sub_resource type="Resource" id="Resource_18ksk"]
script = ExtResource("88_bi3pr")
id = &"rotten"
title = "Rotten"
words = PackedStringArray("Rotten")
icon = ExtResource("105_vdjcu")
text = "Debuff. -1 maximales Leben pro Stack; das Leben sinkt mit. Baut sich nicht ab."

[sub_resource type="Resource" id="Resource_xunj5"]
script = ExtResource("88_bi3pr")
id = &"armor"
title = "Armor"
words = PackedStringArray("Armor")
icon = ExtResource("106_6ecqk")
text = "Buff. Fängt 1 Schaden pro Stack ab und verliert dabei den Stack. Armor Break entfernt ihn."

[sub_resource type="Resource" id="Resource_282b6"]
script = ExtResource("88_bi3pr")
id = &"hasted"
title = "Hasted"
words = PackedStringArray("Hasted")
icon = ExtResource("107_e55j2")
text = "Buff. Nächster Cast -0,1 s pro Stack; dabei werden alle Stacks verbraucht. Höchstens 10 Stacks, hebt sich 1 : 1 mit Slowed auf."

[sub_resource type="Resource" id="Resource_jpsvq"]
script = ExtResource("88_bi3pr")
id = &"life_regen"
title = "Leben-Reg"
words = PackedStringArray("Leben-Reg")
icon = ExtResource("108_mkia2")
text = "Buff. 1 Heilung pro Stack und Sekunde, danach -1 Stack."

[sub_resource type="Resource" id="Resource_gh71o"]
script = ExtResource("88_bi3pr")
id = &"mana_regen"
title = "Mana-Reg"
words = PackedStringArray("Mana-Reg")
icon = ExtResource("109_ajftg")
text = "Buff. +1 Mana pro Stack und Sekunde (zu den 6 Grund-Mana), danach -1 Stack."

[sub_resource type="Resource" id="Resource_giws7"]
script = ExtResource("88_bi3pr")
id = &"bless"
title = "Bless"
words = PackedStringArray("Bless")
icon = ExtResource("110_qfkba")
text = "Buff. Jede erhaltene Heilung +5 pro Stack; verbraucht 1 Stack."

[sub_resource type="Resource" id="Resource_urxhd"]
script = ExtResource("88_bi3pr")
id = &"thorns"
title = "Thorns"
words = PackedStringArray("Thorns")
icon = ExtResource("111_ngk4v")
text = "Buff. Trifft ein gegnerischer Spell: 3 Schaden pro Stack an den Angreifer; verbraucht 1 Stack."

